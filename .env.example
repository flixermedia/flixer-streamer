# Listen port (default: 8091)
PORT=8091

# Generate a unique random secret of at least 32 bytes and configure the same
# value as APP_SECRET in Flixer. Do not use this placeholder.
APP_SECRET=replace-this-with-a-random-secret-at-least-32-bytes

# Root media folders are not configured here: flixer-streamer fetches them from flixer
# (STREAM_MEDIA_ROOT in flixer's environment), signing the request with APP_SECRET.

# Remuxing and resolution changes need ffmpeg and ffprobe on PATH, or set these.
FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Maximum simultaneous ffmpeg remux/transcode processes. 0 (default) means unlimited.
MAX_TRANSCODES=0
# ffmpeg output forwarded to the streamer log: quiet, error, warning, info, verbose, debug, trace
FFMPEG_LOG_LEVEL=info
# Reserved for the future HLS phase.
TRANSCODE_DIR=./cache/transcode

# Optional comma-separated browser origins, e.g. https://app.example.com.
# Empty disables cross-origin browser access.
ALLOWED_ORIGINS=
LOG_LEVEL=info

# Base URL of flixer. On startup the streamer waits up to 60 seconds for flixer to say
# whether Sentry error monitoring is enabled (and which DSN to use); if flixer
# cannot be reached it starts with Sentry disabled. Toggle it in the admin dashboard.
FLIXER_URL=http://localhost:8083

# Shared hover-seek thumbnail sheets generated by flixer-indexer (mount read-only).
TRICKPLAY_DIR=/data/cache/trickplay
