# Listen port (default: 8091)
PORT=8091

# Generate a unique random secret of at least 32 bytes and configure the same
# value as STREAM_TOKEN_SECRET in Flixer. Do not use this placeholder.
STREAM_TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-bytes

# Prefer a JSON array on Windows and when paths contain a colon.
MEDIA_ROOTS=["/media/movies","/media/tv","/media/anime"]

# Remuxing and resolution changes need ffmpeg and ffprobe on PATH, or set these.
FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Maximum simultaneous ffmpeg remux/transcode processes. 0 (default) means unlimited.
MAX_TRANSCODES=0
# ffmpeg output forwarded to the streamer log: quiet, error, warning, info, verbose, debug, trace
FFMPEG_LOG_LEVEL=info
# Reserved for the future HLS phase.
TRANSCODE_DIR=./cache/transcode

# Optional comma-separated browser origins, e.g. https://app.example.com.
# Empty disables cross-origin browser access.
ALLOWED_ORIGINS=
LOG_LEVEL=info
