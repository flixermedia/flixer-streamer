# Proposed Flixer backend settings for the playback-info integration.
# Flixer does not currently issue streamer tokens; do not treat this as an
# active configuration until backend integration is implemented.
APP_SECRET=replace-this-with-the-same-random-secret-as-flixer-streamer
STREAMER_BASE_URL=http://flixer-streamer:8091

# Shared hover-seek thumbnail sheets generated by flixer-indexer (mount read-only).
TRICKPLAY_DIR=/data/cache/trickplay
